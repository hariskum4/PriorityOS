generator client {
  provider = "prisma-client-js"
  // The query engine is a native binary, and Prisma only ships the one for
  // the machine that ran `generate` unless told otherwise. Vercel builds on
  // Amazon Linux 2023 and runs functions there too, so without the second
  // target the function boots and then dies on its first query with
  // "Query engine binary for current platform could not be found" — a build
  // that passes and a deployment that cannot answer.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Supabase/pooled setups: migrations run against the direct (5432) URL.
  // Falls back to DATABASE_URL locally where DIRECT_URL is unset.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Users & preferences
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String?
  fullName            String
  dob                 DateTime?
  timezone            String    @default("Asia/Kolkata")
  city                String?
  country             String?
  profession          String?
  workType            String?
  workHoursPerWeek    Int?
  // Hours a day on screens outside work. Null until they say — the screen
  // trade quotes no figure without one, rather than assuming a house default.
  screenHoursPerDay   Int?
  // When the working day starts and ends, and the commute each way. The app
  // knew how many hours someone worked and never when — which is the whole
  // difference between "family is short" and "after dinner, before the laptop".
  // Null means the day shape says so rather than inventing a 9-to-5.
  workStartHour       Int?
  workEndHour         Int?
  commuteMinutes      Int?
  /// Which weekdays are working ones, 0 = Sunday. Empty means never asked.
  ///
  /// The day card had a "day off" chip that reset every midnight, so a
  /// weekend meant tapping it on Saturday and again on Sunday, fifty-two
  /// times a year, to say a thing that was true the first time. A correction
  /// that has to be repeated is a question that should have been asked.
  workDays            Int[]     @default([])
  /// Self-declared, and deliberately not a medical field.
  ///
  /// `needs: ['canMove']` on a rhythm asks whether the ROOM allows moving —
  /// so a strength session was still offered to somebody with a back injury
  /// standing in a perfectly open room. Three answers, no diagnosis, no
  /// follow-up questions: 'none' behaves exactly as before, 'low_impact'
  /// swaps a vigorous offer for its gentle twin, and 'ask_doctor' does the
  /// same and says why once.
  movementLimits      String?
  // A declared season: one part of life the person chose to concentrate on,
  // and the date it ends. `suggestSeason` picked one before this and nothing
  // read it; a focus without an end date is neglect with a nicer name, so the
  // two columns travel together and the system counts the second one down.
  focusDomain         String?
  focusUntil          DateTime?
  focusStartedAt      DateTime?
  focusReason         String?
  maritalStatus       String?
  childrenCount       Int       @default(0)
  /// Whether their parents live somewhere else — nullable, because "we never
  /// asked" is a third state and defaulting it to `false` was an assertion.
  ///
  /// `@default(false)` meant every account that skipped the question was
  /// recorded as living WITH their parents. The quick-start lane never shows
  /// that question at all, so every fast onboarding said it — and
  /// `rhythms.service` reads `=== false` to suppress "Call home, the same day
  /// every week", so the app quietly withheld a relevant rhythm from people
  /// it had simply never asked. Same rule as `parentsInLife` below: only an
  /// explicit answer means anything.
  livesAwayFromParents Boolean?
  /// Whether there are parents in this life to direct anything at.
  ///
  /// `livesAwayFromParents` is a boolean, so for years the only answers were
  /// "near them" and "away from them" — and an 87-year-old, or anyone whose
  /// parents have died or are not in their life, could say neither. They
  /// answered "away", which is the truthful half of a wrong question, and the
  /// app spent the next year offering them "Call home, the same day every
  /// week" and "Ask one thing you have never asked — your parents carry a
  /// whole life you have not heard".
  ///
  /// Three states on purpose. `null` is "never asked", which is every account
  /// that existed before this column and is NOT the same as "no" — silence
  /// must not delete somebody's mother. Only an explicit `false` suppresses
  /// parent-directed content.
  parentsInLife       Boolean?
  onboardingCompleted Boolean   @default(false)
  preferredLanguage   String    @default("en")
  motivationStyle     String    @default("balanced") // gentle | balanced | challenging
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  preferences         UserPreferences?
  onboardingAnswers   OnboardingAnswer[]
  relationships       Relationship[]
  lifeDomains         LifeDomain[]
  goals               Goal[]
  missions            Mission[]
  habits              Habit[]
  journalEntries      JournalEntry[]
  memories            Memory[]
  opportunityInsights OpportunityInsight[]
  aiRecommendations   AiRecommendation[]
  personalCatalog     PersonalCatalogItem[]
  weeklyReviews       WeeklyReview[]
  gamification        GamificationProfile?
  xpLedger            DomainXpEntry[]
  notifications       Notification[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  analyticsEvents     AnalyticsEvent[]
  partnerLinks        PartnerLink[]  @relation("owner")
  partneredWith       PartnerLink[]  @relation("partner")
  decisions           Decision[]
  knowledgeItems      KnowledgeItem[]
  attentionSamples    DomainAttentionSample[]
  lifeOsState         LifeOsState?
  lastSeenAt          DateTime?      // for "notice when you go quiet"
  reengagedAt         DateTime?      // last time we sent a warm return nudge
}

/// Product analytics — the funnel and retention truth. Self-contained so a
/// solo founder can read D1/D7/D30 without an external SDK. Named events with
/// arbitrary props; no PII beyond the userId FK.
model AnalyticsEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   // onboarding_started | onboarding_completed | mission_completed | ...
  props     Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
}

/// Accountability / family link — the two-sided moat. A partner sees broad
/// signal (completion rate, streaks, domain balance) and NEVER content:
/// no priority titles, relationships, journal, or memories cross the line.
model PartnerLink {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation("owner", fields: [ownerId], references: [id], onDelete: Cascade)
  partnerId   String?
  partner     User?    @relation("partner", fields: [partnerId], references: [id], onDelete: SetNull)
  inviteEmail String   // who was invited
  status      String   @default("pending") // pending | active | declined
  createdAt   DateTime @default(now())

  @@index([ownerId])
  @@index([partnerId])
}

model UserPreferences {
  id                    String  @id @default(uuid())
  userId                String  @unique
  user                  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderTone          String  @default("warm")     // warm | direct | minimal
  insightIntensity      String  @default("gentle")   // off | gentle | direct  (PRD: mortality framing must be controllable)
  quietHoursStart       Int     @default(22)         // hour of day, user tz
  quietHoursEnd         Int     @default(7)
  preferredReminderHour Int     @default(8)
  gamificationEnabled   Boolean @default(true)
  weeklyReviewDay       Int     @default(0)          // 0 = Sunday
  updatedAt             DateTime @updatedAt
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// A six-digit code mailed to the account address. Hashed like the refresh
// token, because a leaked table must not be a skeleton key. `attempts` exists
// because six digits is guessable in a million tries — five wrong answers
// burn the code.
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Onboarding
// ---------------------------------------------------------------------------

model OnboardingAnswer {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  section   String   // profile | values | relationships | lifestyle | goals | motivation
  key       String
  value     Json
  createdAt DateTime @default(now())

  @@unique([userId, section, key])
}

// ---------------------------------------------------------------------------
// Relationships
// ---------------------------------------------------------------------------

model Relationship {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  reachOutLine          String?  // "reach out with this" — memory-grounded, refreshed by the drift cron
  reachOutLineAt        DateTime?
  relationType          String   // mother | father | spouse | child | friend | sibling | mentor ...
  age                   Int?
  city                  String?
  closenessScore        Int?     // 1..10
  inPersonFrequency     String?  // Cadence
  healthStatus          String?  // good | declining | serious — user-described, never inferred
  locationType          String?  // same_home | same_city | different_city | abroad
  callFrequency         String?  // Cadence
  desiredCallFrequency  String?  // Cadence — what the user WANTS
  wantsMoreTime         Boolean  @default(true)
  meaningfulMomentTypes Json     @default("[]")
  lastContactAt         DateTime?
  lastVisitAt           DateTime?
  priorityScore         Decimal  @default(0) @db.Decimal(5, 2)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  missions              Mission[]
  contactLogs           ContactLog[]
  memories              Memory[]

  insights              OpportunityInsight[]

  // One person, one row. Enforced in the database by a case-insensitive
  // unique index on ("userId", lower(name), "relationType") — created in
  // migration 20260728220000_merge_duplicate_people, because Prisma cannot
  // express a functional index in this schema. Do not drop it: without it,
  // one person's history silently splits across rows.
  @@index([userId])
}

/// One-tap contact logging ("I called Mom") — near-zero friction is what
/// killed manual personal CRMs; this table is fed by mission completion too.
model ContactLog {
  id             String       @id @default(uuid())
  relationshipId String
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  kind           String       // call | visit | message | activity
  note           String?
  occurredAt     DateTime     @default(now())

  @@index([relationshipId, occurredAt])
}

/// The Memory Archive — the retention moat: users do not delete the app
/// where their memories live. Text-first MVP; media columns come with
/// object storage. `countKey` links a memory to a user-defined Time
/// Reality count ("Diwalis at home"), turning countdowns into a record
/// of moments spent well.
model Memory {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationshipId String?
  /// Declared as a real relation as of migration 20260728234500. Before that
  /// this was a bare string with no foreign key, so deleting a person left the
  /// memory pointing at a row that no longer existed — a dangling id nothing
  /// would ever catch.
  relationship   Relationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  /// Snapshot of who this moment was about, so it survives their deletion.
  /// The id goes to NULL when they are removed; without the name the memory
  /// would keep its words and quietly lose its subject.
  personName     String?
  missionId      String?
  title          String
  memoryType     String    @default("moment") // relationship | experience | achievement | reflection | gratitude | moment
  domainType     String?
  countKey       String?   // links to a custom Time Reality count
  peoplePresent  Json      @default("[]")
  location       String?
  reflection     String?   // "What happened?" — the account of the thing
  /// The two beats that turn a row into something worth re-reading.
  ///
  /// A memory had one prose field, which made the archive a list of titles
  /// with dates. What people go back to a diary for is the substance — what
  /// was actually said, and the part that stayed with them — and neither had
  /// anywhere to live. Both optional and both hidden until asked for: the
  /// form must not become a questionnaire, which is the failure mode that
  /// empties a journal faster than a blank page.
  conversation   String?   // "What did we talk about?"
  keepsake       String?   // "What do you want to remember about it?"
  occurredAt     DateTime  @default(now())
  /// Whether the hour on `occurredAt` means anything.
  ///
  /// The column has always been a DateTime and has always carried a time, and
  /// for most rows that time is when somebody typed — 44% of the archive had
  /// `occurredAt` within a minute of `createdAt`. Showing it would put an
  /// invented hour on somebody's evening, so the record has to say which of
  /// the two it is holding rather than leaving every reader to guess.
  ///
  /// True only where the app genuinely watched the clock: a moment kept from
  /// a finished mission, dated from `mission.completedAt`. False everywhere
  /// else, including every row that existed before this column, which is why
  /// the default is the cautious one.
  timeKnown      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([userId, occurredAt])
  @@index([userId, countKey])
}

// ---------------------------------------------------------------------------
// Life domains & goals
// ---------------------------------------------------------------------------

model LifeDomain {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainType        String   // DomainType from @priority/types
  priorityRank      Int?
  flaggedAsNeglected Boolean @default(false)
  regretRiskFlagged Boolean  @default(false)
  importanceScore   Decimal  @default(0) @db.Decimal(5, 2)
  attentionScore    Decimal  @default(0) @db.Decimal(5, 2)
  prevAttentionScore Decimal @default(0) @db.Decimal(5, 2)
  neglectRiskScore  Decimal  @default(0) @db.Decimal(5, 2)
  healthScore       Decimal  @default(0) @db.Decimal(5, 2)
  trend             String   @default("flat")
  lastMeaningfulActionAt DateTime?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  goals             Goal[]

  @@unique([userId, domainType])
}

model Goal {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId     String?
  domain       LifeDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  domainType   String
  /// A name, not an essay. GoalsService derives this via deriveGoalTitle()
  /// (GOAL_TITLE_MAX = 72) and puts any longer prose in `description`; the cap
  /// is the backstop for anything that bypasses the service.
  title        String      @db.VarChar(120)
  description  String?
  horizon      String      @default("1y") // 1y | 5y
  targetDate   DateTime?
  status       String      @default("active") // active | achieved | abandoned
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  missions     Mission[]

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Missions & habits
// ---------------------------------------------------------------------------

model Mission {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationshipId   String?
  relationship     Relationship? @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  goalId           String?
  goal             Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  domainType       String
  missionType      String        // one_time | ritual | milestone | relationship | recovery
  priorityScore    Decimal       @default(0) @db.Decimal(5, 2)
  dueDate          DateTime?
  recurrenceRule   String?
  estimatedMinutes Int?
  energyLevel      String?       // low | medium | high
  xpReward         Int           @default(25)
  status           String        @default("pending") // pending | completed | skipped | expired
  sourceType       String        @default("AI")      // AI | user | system
  /// Which catalog entry this came from. Same contract as Habit.sourceKey —
  /// a rhythm key, an exact ladder rung title, or `lever.<key>`; null for
  /// anything a person wrote themselves.
  sourceKey        String?
  aiRationale      String?       // LLM-generated "why this, why today"
  completedAt      DateTime?
  snoozeCount      Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, status])
  @@index([userId, domainType])
}

model Habit {
  id                 String     @id @default(uuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  domainType         String
  relationshipId     String?
  targetPerWeek      Int        @default(3)   // frequency target, not daily-perfect
  // When this rhythm runs, once the reader has said so themselves. Both null
  // until then, and the engine derives the answer from what they actually do.
  // Lived in device storage first, which meant an answer given on a phone was
  // a different answer from the one given on a laptop.
  plannedDays        Json?                    // Weekday numbers, 0 = Sunday
  plannedMinute      Int?                     // Minutes from local midnight
  streakCurrent      Int        @default(0)
  streakBest         Int        @default(0)
  graceRemaining     Int        @default(1)   // forgiving streaks
  xpReward           Int        @default(10)
  isActive           Boolean    @default(true)
  sourceType         String     @default("AI")
  /// Which catalog entry this came from — a rhythm key, an exact ladder rung
  /// title, or `lever.<key>`. Null for something typed by hand.
  ///
  /// Everything downstream of the catalog matched on *titles*, which works and
  /// is brittle in a specific way the catalog's own comments admit: editing a
  /// title re-offers it to everyone who already has it. It also makes the one
  /// question worth asking in six months unanswerable — which entries people
  /// actually keep at week six, and for which kind of deficit. Titles get
  /// rephrased per person by the AI layer; identities do not.
  ///
  /// Nullable and best-effort. Title matching stays as the fallback, because
  /// hand-typed habits have no catalog identity and never will.
  sourceKey          String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  logs               HabitLog[]

  @@index([userId])
}

model HabitLog {
  id          String   @id @default(uuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())
  note        String?

  @@index([habitId, completedAt])
}

// ---------------------------------------------------------------------------
// Journal
// ---------------------------------------------------------------------------

model JournalEntry {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood          Int?     // 1..5
  gratitude     String?
  whatMattered  String?
  whatIAvoided  String?
  gladNotPostponed String?
  freeText      String?
  domainTags    Json     @default("[]") // DomainType[] — feeds attention scoring
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Intelligence outputs
// ---------------------------------------------------------------------------

model OpportunityInsight {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationshipId String?
  relationship   Relationship? @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  domainType     String
  kind           String        // visits_remaining | calls_per_year | habit_delta
  headline       String
  detail         String
  assumptions    Json          @default("[]")
  estimate       Decimal       @db.Decimal(10, 2)
  unit           String
  // The three halves of an estimate that were computed and then thrown away.
  //
  // `estimate` alone is a number with no shape: a screen holding it could not
  // say what span it covers, nor what one change would make of it, so the one
  // screen that wanted both invented its own arithmetic and disagreed with the
  // engine — it told a person that visiting more often would leave them with
  // fewer visits. Nullable because not every kind of insight has a horizon or
  // an agency counterpart, and a missing one must read as "not applicable"
  // rather than as zero.
  horizonYears   Decimal?      @db.Decimal(5, 2)
  upliftEstimate Decimal?      @db.Decimal(10, 2)
  upliftLabel    String?
  shownAt        DateTime?
  dismissed      Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([userId])
}

model AiRecommendation {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String   // life_reveal | daily_focus | coaching | journal_summary | nudge
  content    Json
  model      String?
  createdAt  DateTime @default(now())

  @@index([userId, kind, createdAt])
}

/// A catalog entry written for one person rather than for everyone.
///
/// The built-in catalogs are 36 rhythms and 31 stacks that every account
/// shares. These are the ones a generation proposed and the engine's judge
/// allowed to exist, and they join the same pools the built-ins feed — they
/// do not replace them, and a person with none of these sees exactly the app
/// that shipped.
///
/// `payload` holds the item already in engine shape, because it was validated
/// into that shape before it was ever written. Nothing downstream re-parses a
/// model's output; by the time a row exists, the judging is done.
model PersonalCatalogItem {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String   // rhythm | stack
  /// The generated key. Unique per person per kind, so a later generation
  /// updates an entry rather than silently shadowing it.
  key        String
  domainType String?  // rhythms only; stacks carry their domains in the payload
  payload    Json
  /// Turned off by the reader, not deleted. Something the app invented and a
  /// person rejected is a fact worth keeping — it must not come back in the
  /// next generation, and a delete would lose that.
  isActive   Boolean  @default(true)
  /// Which generation produced it, so a refresh can tell new from carried-over.
  generation Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, kind, key])
  @@index([userId, kind, isActive])
}

model WeeklyReview {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart          DateTime
  weekEnd            DateTime
  completedMissions  Int      @default(0)
  /// How many of `completedMissions` left a kept moment behind.
  ///
  /// The one number the week's page could not previously produce, and the
  /// only honest answer to "did I do these things or did I tap them". Marking
  /// something done is one tap; writing a line about it is not. Counting both
  /// and showing them side by side lets the gap speak for itself, which is the
  /// only judgment here — the app never says a word about it.
  missionsWithMoment Int      @default(0)
  completedHabits    Int      @default(0)
  journalEntries     Int      @default(0)
  domainDeltas       Json     @default("{}") // { domainType: { attention, neglectRisk, delta } }
  topWins            Json     @default("[]")
  neglectedDomains   Json     @default("[]")
  regretRiskFocus    String?
  nextWeekFocus      Json     @default("[]")
  aiNarrative        String?
  journalThemes      Json     @default("[]") // themes noticed in the week's journal entries
  avoidancePattern   String?  // gently-named recurring avoidance, from their own words
  domainSelfScores   Json     @default("{}") // Sunday Session step 2: { domainType: 1..10 }
  weekWord           String?  // step 1: the week in one word
  oneThing           String?  // step 5: what matters most next week
  intentionWord      String?  // step 6: intention for the week
  sessionCompletedAt DateTime? // full 6-step Sunday Session finished
  userCompletedAt    DateTime? // when the user actually read/acknowledged it
  createdAt          DateTime @default(now())

  @@unique([userId, weekStart])
}

// ---------------------------------------------------------------------------
// Gamification
// ---------------------------------------------------------------------------

model GamificationProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalXp       Int      @default(0)
  level         Int      @default(1)
  dailyStreak   Int      @default(0)
  bestStreak    Int      @default(0)
  graceRemaining Int     @default(1)
  lastActiveDate DateTime?
  badges        Json     @default("[]")
  updatedAt     DateTime @updatedAt
}

model DomainXpEntry {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainType String
  amount     Int
  reason     String   // mission_completed | habit_completed | weekly_review_completed ...
  refId      String?
  createdAt  DateTime @default(now())

  @@index([userId, domainType])
}

// ---------------------------------------------------------------------------
// Notifications & config
// ---------------------------------------------------------------------------

model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String    // daily_mission | streak | relationship_drift | weekly_review | drift_alert
  title       String
  body        String
  dedupeKey   String?   // prevents duplicate spam (kind+date+ref)
  scheduledFor DateTime
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([scheduledFor, sentAt])
}

model AppConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Life OS kernel — host-side storage for @priority/life-os
//
// The kernel itself is pure: it takes an EngineContext and returns observations
// and proposals. These four models are the state it cannot hold for itself —
// the decisions being weighed, the knowledge library, the weekly history that
// trends are computed from, and the ration clock that keeps profound truths
// rare across cycles.
// ---------------------------------------------------------------------------

/// A real fork in a life, held open while the person thinks.
///
/// Options live in Json rather than a child table because they are always read
/// and written together, and their factor set is owned by the engine's `Factor`
/// union rather than by the database.
model Decision {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What they are deciding, in their own words.
  question    String   @db.VarChar(200)
  /// DecisionOption[] from @priority/life-os — { id, label, scores, isStatusQuo, reversible }
  options     Json     @default("[]")
  /// Years over which consequences should be judged. Longer favours values.
  horizonYears Int     @default(5)
  status      String   @default("open")   // open | decided | abandoned
  /// Which option they actually chose, once they do. The raw material for
  /// learning whether our leans were any good.
  chosenOptionId String?
  decidedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
}

/// Books, articles, podcasts, notes — everything taken in, as connected
/// knowledge rather than a reading list.
model KnowledgeItem {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String   // book | article | podcast | video | note | course
  title         String   @db.VarChar(300)
  /// Normalised lowercase tags. The join key to goals and decisions.
  topics        Json     @default("[]")
  status        String   @default("queued")  // queued | active | finished | released
  domainType    String?
  /// 0..1 where the medium has a position.
  progress      Decimal? @db.Decimal(4, 3)
  lastTouchedAt DateTime?
  /// One line the person kept, in their words. Shown verbatim, never rewritten.
  takeaway      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
}

/// A weekly snapshot of one domain's standing.
///
/// LifeDomain holds only *current* scores, and the Regret and Prediction engines
/// need history — a pattern is not a moment, and a trend needs at least six
/// points. One row per user per domain per week, written by the weekly snapshot
/// job. Until enough rows accumulate those engines correctly stay silent.
model DomainAttentionSample {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainType String
  /// Monday of the week this samples, at UTC midnight. The idempotency key.
  weekOf     DateTime @db.Date
  importance Decimal  @default(0) @db.Decimal(5, 2)
  attention  Decimal  @default(0) @db.Decimal(5, 2)
  /// Self-reported energy for the week, when given. The strongest burnout
  /// signal available without wearables.
  energy     Decimal? @db.Decimal(5, 2)
  createdAt  DateTime @default(now())

  @@unique([userId, domainType, weekOf])
  @@index([userId, weekOf])
}

/// Cross-cycle memory for the orchestrator.
///
/// The kernel is stateless by design, so the two things it must remember
/// between cycles live here: when a profound truth was last shown (the ration
/// clock) and which findings have already been delivered, so the same truth is
/// never re-served as though it were news.
model LifeOsState {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastProfoundAt      DateTime?
  /// Observation ids already surfaced. Trimmed to a bounded window.
  seenObservationIds  Json     @default("[]")
  /// Topics the person has permanently declined. The Retreat principle: one
  /// tap, honoured forever, never followed by a survey asking why.
  declinedTopics      Json     @default("[]")
  lastCycleAt         DateTime?
  updatedAt           DateTime @updatedAt
}
