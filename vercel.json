{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "installCommand": "npm install",
  "outputDirectory": "apps/mobile/dist",
  "framework": null,
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{apps/api/dist/**,apps/api/prisma/**,node_modules/.prisma/**,node_modules/@prisma/**,node_modules/@vercel/**,packages/*/dist/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 3 * * 0"
    }
  ]
}
