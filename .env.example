# ---------- API ----------
DATABASE_URL=postgresql://priority:priority@localhost:5432/priority?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d
PORT=3001

# ---------- AI layer (OpenRouter — OpenAI-compatible; also works with OpenAI, Groq, Ollama, etc.) ----------
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-...
AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free   # any OpenRouter :free model; lighter alt: openai/gpt-oss-20b:free
AI_ENABLED=true            # false = deterministic fallback copy, app fully usable offline

# ---------- Mobile ----------
EXPO_PUBLIC_API_URL=http://localhost:3001
DATA_ENCRYPTION_KEY=change-me-32-bytes-base64

# ---------- Operator tooling (NOT read by the app) ----------
#
# A Render API key, for inspecting and changing the deployed service from a
# shell instead of the dashboard. Nothing in apps/api or apps/mobile reads
# this — it exists so that whoever is operating the deploy can do it without
# borrowing a browser session, and so the key has one obvious home rather
# than being pasted into a terminal and lost in shell history.
#
# Make one at: Render dashboard -> Account Settings -> API Keys.
# It is account-wide and can create and delete services, so treat it like a
# password: keep it in .env (git-ignored), never in .env.example, and revoke
# it when the work that needed it is done.
#
# Deliberately NOT set in Render's own environment. The service has no reason
# to hold a key that can delete the service.
RENDER_API_KEY=rnd_...

# The service this key is usually pointed at, so commands do not have to
# rediscover it. Find it in the dashboard URL: /web/srv-xxxxxxxxxxxx
RENDER_SERVICE_ID=srv-...

